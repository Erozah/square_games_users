meta {
  name: 6. Coup par le mauvais joueur -> 403 Forbidden
  type: http
  seq: 6
}

post {
  url: {{gamesBaseUrl}}/games/{{gameId}}/moves
  body: json
  auth: none
}

headers {
  Authorization: Bearer<token>: {{otherPlayerId}}
}

body:json {
  {
    "x": 0,
    "y": 0
  }
}

tests {
  test("Status 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
