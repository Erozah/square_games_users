}

post {
  url: {{usersBaseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "alice",
    "email": "alice@example.com"
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("aliceId", res.getBody().id);
  });
